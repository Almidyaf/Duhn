# Supabase Transaction Pooler (Port 6543) for runtime queries
# Local Docker DB (npm run db:dev): postgresql://duhn_app:YOUR_PASSWORD@127.0.0.1:55438/duhn
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase Session Pooler (Port 5432) for migrations & advisory locks
# Local Docker DB: postgresql://duhn_admin:YOUR_ADMIN_PASSWORD@127.0.0.1:55438/duhn
MIGRATION_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# Supabase Project Credentials
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Better Auth (Production: https://duhn.almidyaf.com | Local: http://localhost:3108)
BETTER_AUTH_URL=https://duhn.almidyaf.com
BETTER_AUTH_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
