{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "duhn",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "95c85beb39a84d82ac1f7d9d6544f689",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/postgres"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://duhn.almidyaf.com",
    "NEXT_PUBLIC_SUPABASE_URL": "https://kzrtiaclfkhnwewsxvnl.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_zMbdz8aR6uIvhhHcqYWFZg_-i_nGxlD"
  },
  "routes": [
    {
      "pattern": "duhn.almidyaf.com",
      "custom_domain": true
    }
  ]
}
